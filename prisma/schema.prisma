// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusOrdemServico {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  FINALIZADA
}

// Um cliente pode possuir várias motos.
// Restrict:
// se o cliente possuir alguma moto vinculada,
// ele não poderá ser excluído.
model Cliente {
  id          String   @id @default(uuid())
  nome        String
  telefone    String
  cpf         String?
  rua         String
  bairro      String
  numero      String
  cidade      String
  complemento String?
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  motos       Moto[] // Lado muitos da relação entre Cliente e Moto.
  // Um Cliente pode estar relacionado a várias Motos.
}

// Cada moto pertence a um único cliente.
// clienteId é a FK que referencia Cliente.id.
// Restrict:
// se a moto possuir alguma OrdemServico,
// ela não poderá ser excluída.
model Moto {
  id            String         @id @default(uuid())
  clienteId     String
  modelo        String
  placa         String         @unique
  chassi        String         @unique
  cor           String
  ano           Int?
  cilindrada    Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cliente       Cliente        @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  // Cada Moto pertence a um único Cliente.
  // clienteId é a FK que referencia Cliente.id.
  ordensServico OrdemServico[]
}

// Uma OrdemServico pertence a uma Moto
// e pode possuir vários serviços e peças.
// Restrict:
// a Moto não pode ser excluída
// enquanto existir alguma OS vinculada a ela.
model OrdemServico {
  id              String             @id @default(uuid())
  motoId          String
  problema        String
  status          StatusOrdemServico @default(ABERTA)
  dataAbertura    DateTime           @default(now())
  observacao      String?
  dataFinalizacao DateTime?
  moto            Moto               @relation(fields: [motoId], references: [id], onDelete: Restrict)
  servicos        ServicoOrdem[]
  pecas           PecaOrdem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Representa um serviço realizado em uma OS.
// Cascade:
// se a OrdemServico for excluída,
// os serviços vinculados a ela também serão excluídos.
model ServicoOrdem {
  id             String       @id @default(uuid())
  ordemServicoId String
  servico        String
  valor          Decimal      @db.Decimal(10, 2)
  observacao     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
}

// Representa uma peça utilizada em uma OS.
// Cascade:
// se a OrdemServico for excluída,
// o registro PecaOrdem também será excluído.
//
// Restrict:
// se uma peça já estiver vinculada a uma OS,
// ela não poderá ser excluída do cadastro.
model PecaOrdem {
  id             String       @id @default(uuid())
  ordemServicoId String
  pecaId         String
  quantidade     Int
  valorUnitario  Decimal      @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  peca           Peca         @relation(fields: [pecaId], references: [id], onDelete: Restrict)
}

// Cadastro das peças utilizadas pela oficina.
// Uma peça pode estar presente em várias ordens de serviço.
model Peca {
  id                String      @id @default(uuid())
  nome              String
  codigo            String?
  valorCusto        Decimal?    @db.Decimal(10, 2)
  valorVenda        Decimal     @db.Decimal(10, 2)
  quantidadeEstoque Int         @default(0)
  estoqueMinimo     Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  pecasOrdens       PecaOrdem[]
}
